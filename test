

# Method 1: Read the Windows version from the registry
Get-ItemProperty 'HKLM:\SOFTWARE\Microsoft\Windows NT\CurrentVersion' |
    Select-Object ProductName, EditionID, DisplayVersion,
                  CurrentBuild, UBR, InstallationType

# Method 2: Query the OS directly
Get-CimInstance Win32_OperatingSystem |
    Select-Object Caption, Version, BuildNumber, OSArchitecture

# Method 3: Check the installed servicing packages
dism.exe /online /get-packages /format:table



Test-Path "$env:windir\System32\sdclt.exe"
Test-Path "$env:windir\SysWOW64\sdclt.exe"

# Search for the executable within Windows
Get-ChildItem "$env:windir\System32" -Filter sdclt.exe `
    -ErrorAction SilentlyContinue


$path = 'HKLM:\SOFTWARE\Microsoft\Windows\CurrentVersion\Policies\System'

Get-ItemProperty $path |
    Select-Object EnableLUA,
                  ConsentPromptBehaviorAdmin,
                  PromptOnSecureDesktop



$exe = "$env:windir\System32\sdclt.exe"

if (Test-Path $exe) {
    Get-Item $exe |
        Select-Object FullName,
            @{Name='FileVersion'; Expression={$_.VersionInfo.FileVersion}}
    Get-AuthenticodeSignature $exe |
        Select-Object Status, SignerCertificate
} else {
    'sdclt.exe not found at the expected path'
}



$key = 'HKCU:\Software\Classes\Folder\shell\open\command'

if (Test-Path $key) {
    Get-Item $key
    Get-ItemProperty $key
} else {
    'The specified per-user registry key does not exist.'
}


$runKeys = @(
    'HKCU:\Software\Microsoft\Windows\CurrentVersion\Run',
    'HKLM:\Software\Microsoft\Windows\CurrentVersion\Run',
    'HKLM:\Software\WOW6432Node\Microsoft\Windows\CurrentVersion\Run'
)

foreach ($key in $runKeys) {
    if (Test-Path $key) {
        "`n--- $key ---"
        Get-ItemProperty $key
    }
}


Get-CimInstance -Namespace root/subscription `
    -ClassName __EventFilter

Get-CimInstance -Namespace root/subscription `
    -ClassName CommandLineEventConsumer

Get-CimInstance -Namespace root/subscription `
    -ClassName __FilterToConsumerBinding
